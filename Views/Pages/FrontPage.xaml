<Page x:Class="WpfAppT.Views.Pages.FrontPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard" Background="#F7F8FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Фото СТО — займає весь простір -->
        <Grid Grid.Row="0" Margin="24 24 24 12">
            <Border CornerRadius="16" ClipToBounds="True"
                    Background="#E0E0E0">
                <Image x:Name="ShopPhoto" Stretch="UniformToFill"
                       VerticalAlignment="Stretch"
                       HorizontalAlignment="Stretch"/>
            </Border>
            <TextBlock x:Name="PhotoPlaceholder"
                       Text="Auto Service Station"
                       FontSize="28" FontWeight="Bold"
                       Foreground="#9E9E9E" FontFamily="Segoe UI"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <Button Content="Choose Photo"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0 0 16 16"
                    Padding="14 9"
                    Background="#BB000000"
                    Foreground="White" FontSize="13"
                    FontFamily="Segoe UI"
                    BorderThickness="0" Cursor="Hand"
                    Click="ChoosePhoto_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Картки -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="3"
                     Margin="24 0 24 24" Height="100">

            <Border Background="White" CornerRadius="12"
                    Margin="0 0 8 0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                      Color="#000000" Opacity="0.08"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Today" FontSize="12"
                               Foreground="#FF6F00" FontWeight="SemiBold"
                               FontFamily="Segoe UI"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TodayDate" FontSize="20"
                               FontWeight="Bold" FontFamily="Segoe UI"
                               Foreground="#1F2937"
                               HorizontalAlignment="Center"
                               Margin="0 4 0 0"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="12"
                    Margin="4 0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                      Color="#000000" Opacity="0.08"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Specialists" FontSize="12"
                               Foreground="#FF6F00" FontWeight="SemiBold"
                               FontFamily="Segoe UI"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SpecialistsCount" FontSize="36"
                               FontWeight="Bold" FontFamily="Segoe UI"
                               Foreground="#1F2937"
                               HorizontalAlignment="Center"
                               Margin="0 4 0 0"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="12"
                    Margin="8 0 0 0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                      Color="#000000" Opacity="0.08"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Cars in Repair" FontSize="12"
                               Foreground="#FF6F00" FontWeight="SemiBold"
                               FontFamily="Segoe UI"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CarsCount" FontSize="36"
                               FontWeight="Bold" FontFamily="Segoe UI"
                               Foreground="#1F2937"
                               HorizontalAlignment="Center"
                               Margin="0 4 0 0"/>
                </StackPanel>
            </Border>
        </UniformGrid>
    </Grid>
</Page>