<Page x:Class="WpfAppT.Views.Pages.RecordsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Records" Background="#F7F8FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="24 16"
                BorderBrush="#E5E7EB" BorderThickness="0 0 0 1">
            <Grid>
                <TextBlock Text="Records" FontSize="20" FontWeight="Bold"
                           FontFamily="Segoe UI" Foreground="#1F2937"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnAdd" Content="Add Record"
                            Click="BtnAdd_Click" Height="34" Margin="4 0"
                            Background="#FF6F00" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Padding="16 0"
                            FontFamily="Segoe UI" FontSize="13">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnComplete" Content="Mark Complete"
                            Click="BtnComplete_Click" Height="34" Margin="4 0"
                            Background="#2E7D32" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Padding="16 0"
                            IsEnabled="False" FontFamily="Segoe UI" FontSize="13">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnEdit" Content="Edit"
                            Click="BtnEdit_Click" Height="34" Margin="4 0"
                            Background="#1565C0" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Padding="16 0"
                            IsEnabled="False" FontFamily="Segoe UI" FontSize="13">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnDelete" Content="Delete"
                            Click="BtnDelete_Click" Height="34" Margin="4 0"
                            Background="#D32F2F" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Padding="16 0"
                            IsEnabled="False" FontFamily="Segoe UI" FontSize="13">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Ліва частина -->
            <Grid Grid.Column="0" Margin="0 0 12 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Таблиця -->
                <Border Grid.Row="0" Background="White" CornerRadius="12"
                        Margin="0 0 0 12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                          Color="#000000" Opacity="0.06"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="16 12"
                                BorderBrush="#F3F4F6" BorderThickness="0 0 0 1">
                            <TextBlock Text="Active Repairs" FontSize="14"
                                       FontWeight="SemiBold" FontFamily="Segoe UI"
                                       Foreground="#374151"/>
                        </Border>
                        <DataGrid x:Name="RecordsGrid" Grid.Row="1"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  SelectionMode="Single"
                                  SelectionChanged="RecordsGrid_SelectionChanged"
                                  MouseDoubleClick="RecordsGrid_DoubleClick"
                                  Background="White" BorderThickness="0"
                                  RowBackground="White"
                                  AlternatingRowBackground="#FFF8F0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F3F4F6"
                                  ColumnHeaderHeight="40" RowHeight="38"
                                  FontFamily="Segoe UI" FontSize="13"
                                  Foreground="#374151">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#6B7280"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="12 0"/>
                                    <Setter Property="BorderBrush" Value="#F3F4F6"/>
                                    <Setter Property="BorderThickness" Value="0 0 0 1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="12 0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#FFF3E0"/>
                                            <Setter Property="Foreground" Value="#1F2937"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date"
                                                    Binding="{Binding DateAdded, StringFormat=dd.MM.yyyy}"
                                                    Width="90"/>
                                <DataGridTextColumn Header="Brand"
                                                    Binding="{Binding Car.Brand.Name}"
                                                    Width="80"/>
                                <DataGridTextColumn Header="Model"
                                                    Binding="{Binding Car.Model}"
                                                    Width="80"/>
                                <DataGridTextColumn Header="Plate"
                                                    Binding="{Binding LicensePlate}"
                                                    Width="100"/>
                                <DataGridTextColumn Header="Specialist"
                                                    Binding="{Binding Specialist.LastName}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Reason"
                                                    Binding="{Binding Reason}"
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Топи поряд -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="12"
                            Margin="0 0 6 0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                              Color="#000000" Opacity="0.06"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border Padding="16 12" BorderBrush="#F3F4F6"
                                    BorderThickness="0 0 0 1">
                                <TextBlock Text="Top 5 Specialists — Last Month"
                                           FontSize="13" FontWeight="SemiBold"
                                           FontFamily="Segoe UI" Foreground="#374151"/>
                            </Border>
                            <ItemsControl x:Name="TopSpecialistsList" Margin="16 8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0 5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Rank}"
                                                       FontSize="13" FontWeight="Bold"
                                                       Foreground="#FF6F00" FontFamily="Segoe UI"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       FontSize="13" Foreground="#374151"
                                                       FontFamily="Segoe UI"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="#FF6F00"
                                                       FontFamily="Segoe UI"
                                                       VerticalAlignment="Center">
                                                <Run Text="{Binding Count}"/>
                                                <Run Text=" cars"/>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="White" CornerRadius="12"
                            Margin="6 0 0 0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                              Color="#000000" Opacity="0.06"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border Padding="16 12" BorderBrush="#F3F4F6"
                                    BorderThickness="0 0 0 1">
                                <TextBlock Text="Top Car Brands — Last Year"
                                           FontSize="13" FontWeight="SemiBold"
                                           FontFamily="Segoe UI" Foreground="#374151"/>
                            </Border>
                            <ItemsControl x:Name="TopBrandsList" Margin="16 8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0 5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Rank}"
                                                       FontSize="13" FontWeight="Bold"
                                                       Foreground="#FF6F00" FontFamily="Segoe UI"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       FontSize="13" Foreground="#374151"
                                                       FontFamily="Segoe UI"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="#FF6F00"
                                                       FontFamily="Segoe UI"
                                                       VerticalAlignment="Center">
                                                <Run Text="{Binding Count}"/>
                                                <Run Text=" times"/>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Права панель -->
            <Border Grid.Column="1" Background="White" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                      Color="#000000" Opacity="0.06"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- Деталі -->
                        <StackPanel x:Name="DetailPanel" Margin="24">
                            <TextBlock x:Name="DetailPlaceholder"
                                       Text="Select a record to view details"
                                       FontSize="13" Foreground="#9CA3AF"
                                       FontFamily="Segoe UI"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Margin="0 40 0 0"/>
                            <TextBlock x:Name="DetailCar" FontSize="18"
                                       FontWeight="Bold" FontFamily="Segoe UI"
                                       Foreground="#1F2937" Margin="0 0 0 4"
                                       Visibility="Collapsed"/>
                            <TextBlock x:Name="DetailPlate" FontSize="13"
                                       Foreground="#FF6F00" FontWeight="SemiBold"
                                       FontFamily="Segoe UI" Margin="0 0 0 16"
                                       Visibility="Collapsed"/>
                            <Border x:Name="CarPhotoContainer"
                                    Height="160" CornerRadius="8"
                                    Background="#F3F4F6" Margin="0 0 0 16"
                                    ClipToBounds="True" Visibility="Collapsed">
                                <Image x:Name="CarPhoto" Stretch="UniformToFill"/>
                            </Border>
                            <Separator x:Name="DetailSep" Background="#F3F4F6"
                                       Margin="0 0 0 16" Visibility="Collapsed"/>
                            <StackPanel x:Name="DetailInfo" Visibility="Collapsed">
                                <TextBlock Text="Specialist" FontSize="11"
                                           Foreground="#9CA3AF" FontFamily="Segoe UI"
                                           Margin="0 0 0 2"/>
                                <TextBlock x:Name="DetailSpecialist" FontSize="14"
                                           Foreground="#374151" FontFamily="Segoe UI"
                                           Margin="0 0 0 12"/>
                                <TextBlock Text="Customer" FontSize="11"
                                           Foreground="#9CA3AF" FontFamily="Segoe UI"
                                           Margin="0 0 0 2"/>
                                <TextBlock x:Name="DetailCustomer" FontSize="14"
                                           Foreground="#374151" FontFamily="Segoe UI"
                                           Margin="0 0 0 12"/>
                                <TextBlock Text="Date Added" FontSize="11"
                                           Foreground="#9CA3AF" FontFamily="Segoe UI"
                                           Margin="0 0 0 2"/>
                                <TextBlock x:Name="DetailDate" FontSize="14"
                                           Foreground="#374151" FontFamily="Segoe UI"
                                           Margin="0 0 0 12"/>
                                <TextBlock Text="Reason" FontSize="11"
                                           Foreground="#9CA3AF" FontFamily="Segoe UI"
                                           Margin="0 0 0 2"/>
                                <TextBlock x:Name="DetailReason" FontSize="14"
                                           Foreground="#374151" FontFamily="Segoe UI"
                                           TextWrapping="Wrap" Margin="0 0 0 12"/>
                                <TextBlock Text="Master Description" FontSize="11"
                                           Foreground="#9CA3AF" FontFamily="Segoe UI"
                                           Margin="0 0 0 2"/>
                                <TextBlock x:Name="DetailDescription" FontSize="14"
                                           Foreground="#374151" FontFamily="Segoe UI"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Форма -->
                        <StackPanel x:Name="FormPanel" Margin="24"
                                    Visibility="Collapsed">
                            <TextBlock x:Name="FormTitle" FontSize="16"
                                       FontWeight="Bold" FontFamily="Segoe UI"
                                       Foreground="#1F2937" Margin="0 0 0 20"/>
                            <TextBlock Text="Specialist" FontSize="12"
                                       Foreground="#6B7280" FontFamily="Segoe UI"
                                       Margin="0 0 0 4"/>
                            <Border BorderBrush="#E5E7EB" BorderThickness="1"
                                    CornerRadius="6" Margin="0 0 0 12">
                                <ComboBox x:Name="CmbSpecialist" Height="36"
                                          FontFamily="Segoe UI" FontSize="13"
                                          BorderThickness="0" Padding="10 0"
                                          VerticalContentAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Customer" FontSize="12"
                                       Foreground="#6B7280" FontFamily="Segoe UI"
                                       Margin="0 0 0 4"/>
                            <Border BorderBrush="#E5E7EB" BorderThickness="1"
                                    CornerRadius="6" Margin="0 0 0 12">
                                <ComboBox x:Name="CmbCustomer" Height="36"
                                          FontFamily="Segoe UI" FontSize="13"
                                          BorderThickness="0" Padding="10 0"
                                          VerticalContentAlignment="Center"
                                          SelectionChanged="CmbCustomer_SelectionChanged"/>
                            </Border>
                            <TextBlock Text="Car" FontSize="12"
                                       Foreground="#6B7280" FontFamily="Segoe UI"
                                       Margin="0 0 0 4"/>
                            <Border BorderBrush="#E5E7EB" BorderThickness="1"
                                    CornerRadius="6" Margin="0 0 0 12">
                                <ComboBox x:Name="CmbCar" Height="36"
                                          FontFamily="Segoe UI" FontSize="13"
                                          BorderThickness="0" Padding="10 0"
                                          VerticalContentAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Reason" FontSize="12"
                                       Foreground="#6B7280" FontFamily="Segoe UI"
                                       Margin="0 0 0 4"/>
                            <Border BorderBrush="#E5E7EB" BorderThickness="1"
                                    CornerRadius="6" Margin="0 0 0 12">
                                <TextBox x:Name="TxtReason" Height="36"
                                         FontFamily="Segoe UI" FontSize="13"
                                         Padding="10 0" BorderThickness="0"
                                         VerticalContentAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Master Description" FontSize="12"
                                       Foreground="#6B7280" FontFamily="Segoe UI"
                                       Margin="0 0 0 4"/>
                            <Border BorderBrush="#E5E7EB" BorderThickness="1"
                                    CornerRadius="6" Margin="0 0 0 12">
                                <TextBox x:Name="TxtDescription"
                                         FontFamily="Segoe UI" FontSize="13"
                                         Padding="10 8" BorderThickness="0"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True" Height="80"/>
                            </Border>

                            <TextBlock Text="Photo" FontSize="12"
                                       Foreground="#6B7280" FontFamily="Segoe UI"
                                       Margin="0 0 0 4"/>
                            <Grid Margin="0 0 0 20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderBrush="#E5E7EB"
                                        BorderThickness="1" CornerRadius="6"
                                        Margin="0 0 8 0">
                                    <TextBox x:Name="TxtPhotoUrl" Height="36"
                                             FontFamily="Segoe UI" FontSize="13"
                                             Padding="10 0" BorderThickness="0"
                                             IsReadOnly="True"
                                             VerticalContentAlignment="Center"/>
                                </Border>
                                <Button Grid.Column="1" Content="Browse"
                                        Click="BtnBrowsePhoto_Click"
                                        Height="36" Padding="12 0"
                                        Background="#FF6F00" Foreground="White"
                                        BorderThickness="0" Cursor="Hand"
                                        FontFamily="Segoe UI" FontSize="13">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Content="Cancel" Click="BtnCancel_Click"
                                        Width="80" Height="34" Margin="0 0 8 0"
                                        Background="#F3F4F6" Foreground="#374151"
                                        BorderThickness="0" Cursor="Hand"
                                        FontFamily="Segoe UI" FontSize="13">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6" Padding="12 0">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Content="Save" Click="BtnSave_Click"
                                        Width="80" Height="34"
                                        Background="#FF6F00" Foreground="White"
                                        BorderThickness="0" Cursor="Hand"
                                        FontFamily="Segoe UI" FontSize="13">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6" Padding="12 0">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>