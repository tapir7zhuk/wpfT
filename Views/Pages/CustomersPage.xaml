<Page x:Class="WpfAppT.Views.Pages.CustomersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Customers" Background="#F7F8FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок + кнопки -->
        <Border Grid.Row="0" Background="White" Padding="24 16"
                BorderBrush="#E5E7EB" BorderThickness="0 0 0 1">
            <Grid>
                <TextBlock Text="Customers" FontSize="20" FontWeight="Bold"
                           FontFamily="Segoe UI" Foreground="#1F2937"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnAdd" Content="Add"
                            Click="BtnAdd_Click" Width="80" Height="34"
                            Margin="4 0" Background="#FF6F00" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            FontFamily="Segoe UI" FontSize="13">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="12 0">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnDelete" Content="Delete"
                            Click="BtnDelete_Click" Width="80" Height="34"
                            Margin="4 0" Background="#D32F2F" Foreground="White"
                            BorderThickness="0" Cursor="Hand" IsEnabled="False"
                            FontFamily="Segoe UI" FontSize="13">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="12 0">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Контент -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Таблиця -->
            <Border Grid.Column="0" Background="White" CornerRadius="12"
                    Margin="0 0 12 0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                      Color="#000000" Opacity="0.06"/>
                </Border.Effect>
                <DataGrid x:Name="CustomersGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionChanged="CustomersGrid_SelectionChanged"
                          MouseDoubleClick="CustomersGrid_DoubleClick"
                          Background="White" BorderThickness="0"
                          RowBackground="White"
                          AlternatingRowBackground="#FFF8F0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F3F4F6"
                          ColumnHeaderHeight="44" RowHeight="40"
                          FontFamily="Segoe UI" FontSize="13"
                          Foreground="#374151">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#6B7280"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="16 0"/>
                            <Setter Property="BorderBrush" Value="#F3F4F6"/>
                            <Setter Property="BorderThickness" Value="0 0 0 1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="16 0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FFF3E0"/>
                                    <Setter Property="Foreground" Value="#1F2937"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="First Name"
                                            Binding="{Binding FirstName}" Width="*"/>
                        <DataGridTextColumn Header="Last Name"
                                            Binding="{Binding LastName}" Width="*"/>
                        <DataGridTextColumn Header="Phone"
                                            Binding="{Binding PhoneNumber}" Width="*"/>
                        <DataGridTextColumn Header="Cars"
                                            Binding="{Binding Cars.Count}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Права панель -->
            <Border Grid.Column="1" Background="White" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                      Color="#000000" Opacity="0.06"/>
                </Border.Effect>
                <Grid>
                    <!-- Деталі -->
                    <StackPanel x:Name="DetailPanel" Margin="24">
                        <TextBlock x:Name="DetailName" FontSize="18"
                                   FontWeight="Bold" FontFamily="Segoe UI"
                                   Foreground="#1F2937"
                                   HorizontalAlignment="Center"
                                   Margin="0 0 0 4"/>
                        <TextBlock x:Name="DetailPhone" FontSize="13"
                                   Foreground="#FF6F00" FontWeight="SemiBold"
                                   FontFamily="Segoe UI"
                                   HorizontalAlignment="Center"
                                   Margin="0 0 0 20"/>
                        <Separator Background="#F3F4F6" Margin="0 0 0 16"/>

                        <TextBlock Text="Cars" FontSize="12"
                                   Foreground="#6B7280" FontWeight="SemiBold"
                                   FontFamily="Segoe UI" Margin="0 0 0 8"/>
                        <ListBox x:Name="CarsList"
                                 BorderThickness="0" Background="Transparent"
                                 FontFamily="Segoe UI" FontSize="13">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0 4">
                                        <TextBlock Text="{Binding Brand.Name}"
                                                   Foreground="#374151"
                                                   FontWeight="SemiBold"
                                                   Margin="0 0 6 0"/>
                                        <TextBlock Text="{Binding Model}"
                                                   Foreground="#374151"/>
                                        <TextBlock Text=" — " Foreground="#9CA3AF"/>
                                        <TextBlock Text="{Binding LicensePlate}"
                                                   Foreground="#9CA3AF"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Visit History" FontSize="12"
                                   Foreground="#6B7280" FontWeight="SemiBold"
                                   FontFamily="Segoe UI" Margin="0 16 0 4"/>
                        <TextBlock x:Name="DetailVisits" FontSize="14"
                                   Foreground="#374151" FontFamily="Segoe UI"/>

                        <TextBlock x:Name="DetailPlaceholder"
                                   Text="Select a customer to view details"
                                   FontSize="13" Foreground="#9CA3AF"
                                   FontFamily="Segoe UI"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0 40 0 0"/>
                    </StackPanel>

                    <!-- Форма -->
                    <StackPanel x:Name="FormPanel" Margin="24"
                                Visibility="Collapsed">
                        <TextBlock x:Name="FormTitle" FontSize="16"
                                   FontWeight="Bold" FontFamily="Segoe UI"
                                   Foreground="#1F2937" Margin="0 0 0 20"/>

                        <TextBlock Text="First Name" FontSize="12"
                                   Foreground="#6B7280" FontFamily="Segoe UI"
                                   Margin="0 0 0 4"/>
                        <Border BorderBrush="#E5E7EB" BorderThickness="1"
                                CornerRadius="6" Margin="0 0 0 12">
                            <TextBox x:Name="TxtFirstName" Height="36"
                                     FontFamily="Segoe UI" FontSize="13"
                                     Padding="10 0" BorderThickness="0"
                                     VerticalContentAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Last Name" FontSize="12"
                                   Foreground="#6B7280" FontFamily="Segoe UI"
                                   Margin="0 0 0 4"/>
                        <Border BorderBrush="#E5E7EB" BorderThickness="1"
                                CornerRadius="6" Margin="0 0 0 12">
                            <TextBox x:Name="TxtLastName" Height="36"
                                     FontFamily="Segoe UI" FontSize="13"
                                     Padding="10 0" BorderThickness="0"
                                     VerticalContentAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Phone (+380XXXXXXXXX)" FontSize="12"
                                   Foreground="#6B7280" FontFamily="Segoe UI"
                                   Margin="0 0 0 4"/>
                        <Border BorderBrush="#E5E7EB" BorderThickness="1"
                                CornerRadius="6" Margin="0 0 0 20">
                            <TextBox x:Name="TxtPhone" Height="36"
                                     FontFamily="Segoe UI" FontSize="13"
                                     Padding="10 0" BorderThickness="0"
                                     VerticalContentAlignment="Center"/>
                        </Border>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="Cancel" Click="BtnCancel_Click"
                                    Width="80" Height="34" Margin="0 0 8 0"
                                    Background="#F3F4F6" Foreground="#374151"
                                    BorderThickness="0" Cursor="Hand"
                                    FontFamily="Segoe UI" FontSize="13">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6" Padding="12 0">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="Save" Click="BtnSave_Click"
                                    Width="80" Height="34"
                                    Background="#FF6F00" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"
                                    FontFamily="Segoe UI" FontSize="13">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6" Padding="12 0">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>